# GamePilot 本地开发配置示例。
#
# 使用方法：复制为 .env 后按需修改。
#   PowerShell:  Copy-Item .env.example .env
# 真实 .env 已在 .gitignore 中忽略，请勿提交任何真实凭据。

# SQLAlchemy 数据库 URL。
# 格式：postgresql+psycopg://<用户>:<密码>@<主机>:<端口>/<库名>
# 驱动固定为 psycopg 3（同步），本阶段不使用异步驱动。
# 这里的值与 compose.yaml 中 PostgreSQL 的本地开发默认值保持一致。
#
# 主机固定写 127.0.0.1，不要写 localhost：
# 在启用 IPv6 的 Windows 上 localhost 会先解析到 ::1，
# 而端口转发只在 IPv4 上工作，会先卡住直到超时才回退到 127.0.0.1。
DATABASE_URL=postgresql+psycopg://gamepilot:gamepilot@127.0.0.1:5432/gamepilot

# Docker Compose 启动 PostgreSQL 时使用的初始化参数。
# 修改这些值后，需要同步修改上面的 DATABASE_URL。
POSTGRES_DB=gamepilot
POSTGRES_USER=gamepilot
POSTGRES_PASSWORD=gamepilot
POSTGRES_PORT=5432
